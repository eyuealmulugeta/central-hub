rules_version = '2';

// Who may read and write what. Keep in step with js/core/access.js.
//
//   Admin   the Owner: the first person to sign in (recorded in config/setup). Everything.
//           The only one who may delete records, create or delete projects, change
//           settings (prices, rates, letterhead, project settings, billing terms) and
//           manage people. HR records are the Admin's alone.
//   Office  every project, but only the pages the Admin ticked for them (users/<email>.pages;
//           all pages when the Admin has not chosen). Money records need a money page
//           (Costs, Documents or Finance). Issuing a client report needs the approver tick.
//   Site    only the active projects assigned to them: reads the schedule and site data,
//           writes daily reports and follow-ups. Since v0.15.0 the Admin ticks pages for Site people
//           too: a money page ticked lets them read money records (and write costs or draft documents).
//
//   Pay     day rates (crewRates), trade rates (laborRates), pay runs, payments and their labour costs (paycosts):
//           the Admin, and Office people with Costs or Payments ticked. Never Site, whatever is ticked (0.18.0).
//
// The section lists below must match SITE_SECTIONS in js/core/store.js and MONEY_SECTIONS and PAY_SECTIONS in js/core/access.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }
    function setupDoc() { return /databases/$(database)/documents/config/setup; }
    function userDoc() { return /databases/$(database)/documents/users/$(me()); }
    function user() { return get(userDoc()).data; }

    // The Admin: the first person to sign in. Only the Admin writes, edits, deletes and changes settings and permissions.
    // A co-owner (config/setup.coOwners, added by the Admin) may read everything the Admin reads and change nothing.
    function isPrimary() { return signedIn() && exists(setupDoc()) && get(setupDoc()).data.owner == me(); }
    function isOwner() { return isPrimary(); }
    function isCoOwner() { return signedIn() && exists(setupDoc()) && me() in get(setupDoc()).data.get('coOwners', []); }
    function seesAll() { return isPrimary() || isCoOwner(); }
    function hasUser() { return signedIn() && exists(userDoc()); }
    function isOffice() { return hasUser() && user().role == 'office'; }
    function canApprove() { return isOwner() || (isOffice() && user().get('approver', false) == true); }
    function isIssued(d) { return d.type == 'report' && d.status == 'issued'; }
    // A project is open to a Site user only while its status is active (a missing status counts as active).
    function projectOpen(pid) { return get(/databases/$(database)/documents/projects/$(pid)).data.get('status', 'active') == 'active'; }
    // Phase E1: a Field Report phone signed in to Firebase. fieldAccess/<email> is the server's copy of the Field
    // Report access list (functions/access-mirror.js); it reads its projects and their reports, nothing else.
    function fieldDoc() { return /databases/$(database)/documents/fieldAccess/$(me()); }
    function fieldOn(pid) {
      return signedIn() && exists(fieldDoc()) && get(fieldDoc()).data.st == 'active' && pid in get(fieldDoc()).data.pids && projectOpen(pid);
    }
    // v0.37.0: a Field Report account that may make crew form links; v0.41.0: the Admin and the GM (exec) only
    function fieldStaff() {
      return signedIn() && exists(fieldDoc()) && get(fieldDoc()).data.st == 'active' && get(fieldDoc()).data.role in ['admin', 'exec'];
    }
    function isSiteOn(pid) {
      return hasUser() && user().role == 'site' && pid in user().projects && projectOpen(pid);
    }
    // Office people are assigned to projects like Site people: they open only the projects in their list (several allowed).
    function officeOn(pid) { return isOffice() && pid in user().get('projects', []); }
    // The pages a person may open. Keep in step with pagesOf in js/core/access.js. A record the Admin has ticked since
    // v0.15.0 holds them all (pagesV 2). An older one: a Site person had the site pages; an Office person the pages
    // ticked (all until chosen) plus Meetings, Contacts and the staff directory, which came with the role.
    function pages() {
      let u = user();
      return u.get('pagesV', 0) == 2 ? u.get('pages', [])
        : u.role == 'site' ? ['dashboard', 'reports', 'schedule', 'requests', 'directory']
        : u.get('pages', ['dashboard', 'reports', 'schedule', 'ledger', 'estimator', 'docs', 'requests', 'cashflow', 'trade', 'finance', 'contracts'])
            .concat(['meetings', 'contacts', 'directory']);
    }
    function officeWith(list) { return isOffice() && pages().hasAny(list); }
    function isSite() { return hasUser() && user().role == 'site'; }
    // an Office or Site person with one of these pages ticked
    function staffWith(list) { return (isOffice() || isSite()) && pages().hasAny(list); }
    function moneyPages() { return ['ledger', 'cashflow', 'payments', 'docs', 'finance']; }
    // An Office user works in one division (users/<email>.divisions): a record of a divided section is theirs only
    // when it carries that division. Every record says its division since 1D (the first Admin's Central Hub stamped the old ones).
    function mine(d) { return d.get('division', '') in user().get('divisions', []); }
    // a record changed by an Office user: it is theirs before (or new) and stays theirs after
    function keptMine() { return (resource == null || mine(resource.data)) && mine(request.resource.data); }
    function isMoney(section) { return section in ['ledger', 'docs', 'payStages', 'measure', 'billRates', 'payruns', 'payments', 'paycosts', 'crewRates', 'laborRates']; }
    // pay of named people: read by Office only with Costs or Payments ticked, never by Site
    function isPay(section) { return section in ['payruns', 'payments', 'paycosts', 'crewRates', 'laborRates']; }
    function officeSeesPay(section) { return !isPay(section) || officeWith(['ledger', 'payments']); }
    // billing terms and rates are settings: only the Admin changes them
    function isSetting(section) { return section in ['payStages', 'measure', 'billRates', 'crewRates', 'laborRates']; }
    // may this Office user see the records of a project section at all?
    function officeReads(section) { return isOffice() && (!isMoney(section) || officeWith(moneyPages())) && officeSeesPay(section); }
    function officeWrites(section) { return officeReads(section) && !isSetting(section); }
    function officeReadsIn(pid, section) { return officeOn(pid) && (!isMoney(section) || officeWith(moneyPages())) && officeSeesPay(section); }
    // crew pay (Payments) is written only by those with the Payments page ticked
    function officeWritesIn(pid, section) { return officeReadsIn(pid, section) && !isSetting(section) && (!(section in ['payruns', 'payments', 'paycosts']) || officeWith(['payments'])); }
    // Evaluations. Five tiers; each rates the one directly below it, and tier 1 (General Manager) rates
    // everybody. The tier comes from the title. Keep in step with TITLES in js/engine/titles.js.
    function ranks() { return hasUser() ? user().get('ranks', []) : []; }
    function myTier() {
      // v0.47.0: the owner's Excel tiers (js/engine/titles.js): Foreman Tier 3, HR and Project Coordinator Tier 2
      return ranks().hasAny(['general_manager', 'owner', 'ceo', 'board_member']) ? 1
        : ranks().hasAny(['project_manager', 'chief_engineer', 'accountant', 'hse_officer', 'coordinator', 'hr_assistant']) ? 2
        : ranks().hasAny(['site_engineer', 'qs', 'procurement_manager', 'logistics_coordinator', 'office_engineer', 'architect', 'draft_person', 'foreman']) ? 3
        : ranks().hasAny(['technician']) ? 4 : 9;
    }
    function mayRate(level) {
      // v0.49.0: only Tiers 1, 2 and 3 rate (Tier 3 rates the crew and Security), unless the Admin switched them off
      return user().get('evaluate', true) != false && ((level in ['t2', 't3', 't4', 't5'] && myTier() == 1)
        || (level == 't3' && myTier() == 2) || (level in ['t4', 't5'] && myTier() == 3))
        // records written before the tiers
        || (level == 'crew' && 'site_engineer' in ranks())
        || (level == 'site_engineer' && 'project_manager' in ranks())
        || (level == 'project_manager' && 'general_manager' in ranks());
    }
    function salaryOnly() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salaryDone', 'salaryBy']); }

    // Created once, by the first person to sign in. Afterwards only the Admin can change it,
    // and only to hand the role to another address.
    match /config/setup {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == me();
      allow update: if isPrimary() && request.resource.data.owner is string && request.resource.data.owner.size() > 5;
    }

    // People with access, and what each may open: the Admin only. Everyone may read their own entry.
    // Phase E1: the server's copy of the Field Report access list. A phone reads its own; the Admin reads all.
    match /fieldAccess/{email} {
      allow get: if signedIn() && email == me();
      allow read: if seesAll();
      allow write: if false;
    }
    // What a person marked as read, kept for them on every device (js/core/prefs.js): only they read or write it.
    // v0.37.0: "something changed" signals of a project, written by the server only (functions/fieldnow.js)
    match /fieldPing/{pid} {
      allow read: if seesAll() || officeOn(pid) || fieldOn(pid);
      allow write: if false;
    }
    // v0.37.0: small crew photos for Field Report, made on the Admin's computer (js/core/crewphotos.js)
    match /fieldPhotos/{pid} {
      allow read: if seesAll() || fieldOn(pid);
      allow write: if isOwner();
    }
    match /prefs/{email} {
      allow read, write: if signedIn() && email == me();
    }

    // A Project Engineer (rank project_manager) or a Site Engineer is on one project at a time. A record that already lists
    // more (from before this rule) can still be changed, but never given another project.
    function oneProjectOk() {
      let d = request.resource.data;
      let n = d.get('projects', []).size();
      return !d.get('ranks', []).hasAny(['project_manager', 'site_engineer']) || n <= 1
        || (resource != null && n <= resource.data.get('projects', []).size());
    }
    match /users/{email} {
      allow get: if signedIn() && email == me();
      allow read: if seesAll();
      allow create, update: if isOwner() && oneProjectOk();
      allow delete: if isOwner();
    }

    // One signed-in device per person (the Admin is never locked): a device claims sessions/<email>, and a second
    // device cannot take it while the first holds it. It is freed only by signing out (released) or by the Admin
    // deleting it. Being offline or quiet never frees it: a site engineer may be away from signal for days.
    match /sessions/{email} {
      allow get: if signedIn() && (email == me() || seesAll());
      allow list: if seesAll();
      allow create: if signedIn() && email == me() && request.resource.data.email == me();
      allow update: if signedIn() && email == me() && request.resource.data.email == me()
        && (resource.data.deviceId == request.resource.data.deviceId
            || resource.data.get('released', false) == true);
      allow delete: if isOwner();
    }

    // Faults reported by devices (js/core/diagnostics.js): any signed-in person adds their own, small ones; the Admin reads and clears them.
    // v0.26.0: the recycle bin: what the Admin deleted, with who, when and from which page
    match /bin/{id} {
      allow read: if seesAll();
      allow write: if isOwner();
    }
    match /diagnostics/{id} {
      allow create: if signedIn() && request.resource.data.by == me()
        && request.resource.data.keys().hasOnly(['id', 'at', 'where', 'message', 'stack', 'count', 'page', 'agent', 'by'])
        && request.resource.data.message.size() <= 300 && request.resource.data.stack.size() <= 800;
      allow read: if seesAll();
      allow delete: if isOwner();
    }

    // Someone who signed in without having been given access leaves a request here, under their own
    // address. Only the Admin sees the requests, and answers by adding the person (or not).
    match /requests/{email} {
      allow get: if signedIn() && email == me();
      allow create, update: if signedIn() && email == me() && request.resource.data.email == me();
      allow read: if seesAll();
      allow delete: if isOwner();
    }

    // Written only by the server (functions/, Admin SDK): the Field Report import status. Office and the Admin read it.
    match /system/{doc} {
      allow read: if seesAll() || isOffice();
      allow write: if false;
    }

    // Prices, exchange rates, countries, letterhead: settings, so only the Admin changes them.
    match /global/{doc} {
      allow read: if seesAll() || hasUser();
      allow write: if isOwner();
    }

    // Company-wide records. HR (staff) is the Admin's alone. Deleting is the Admin's.
    // Sign. A request (signs) and the parts of its PDF (signfiles) can be read by anyone who has
    // their long random id: that is the link a signer is sent, and signers do not sign in.
    // A signature (signed) is created once, under the signer's own secret key, while the request
    // is open, and is never changed. The keys (signkeys) are for the office only.
    function signStaff() { return isOwner() || staffWith(['contracts']); }
    function signStaffOf(d) { return isOwner() || (staffWith(['contracts']) && mine(d)); }
    function signWriter() { return isOwner() || (staffWith(['contracts']) && keptMine()); }
    match /company/main/signs/{id} {
      allow get: if true;
      allow list: if seesAll() || signStaffOf(resource.data);
      allow create, update: if signWriter();
    }
    match /company/main/signfiles/{id} {
      allow get: if true;
      allow create, update: if signStaff();
    }
    match /company/main/signkeys/{id} {
      allow read: if seesAll() || signStaffOf(resource.data);
      allow create, update: if signWriter();
    }
    match /company/main/signed/{key} {
      allow get: if true;
      allow list: if signStaff() || seesAll();
      allow create: if key.size() >= 40
        && request.resource.data.keys().hasOnly(['id', 'request', 'name', 'image', 'at', 'agent'])
        && request.resource.data.id == key
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.image is string && request.resource.data.image.size() <= 250000
        && request.resource.data.at is string
        && get(/databases/$(database)/documents/company/main/signs/$(request.resource.data.request)).data.status == 'sent';
    }

    // v0.33.0 Crew forms. A link (crewlinks) is read by anyone who has its long random id; it is made by the Admin or
    // anyone with a sign-in (the page is offered to a GM, Project Engineer or Site Engineer), in their own name. A form
    // (crewforms) is left without signing in while its link is open: once for a one-person link (the form's id is the
    // link's), any number under a crew link. Only the Admin reads, changes or deletes forms (HR is the Admin's).
    function crewLinkOf(d) { return get(/databases/$(database)/documents/company/main/crewlinks/$(d.link)).data; }
    function crewText(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function crewFormOk(id, d) {
      return d.keys().hasOnly(['id', 'link', 'doc', 'name', 'gender', 'birthday', 'nationality', 'phone', 'address', 'emergency', 'emergencyPhone', 'trade',
          'idNumber', 'fin', 'passportNumber', 'passportExpiry', 'idExpiry', 'certificate', 'photo', 'idFront', 'idBack', 'passportImage', 'at', 'status'])
        && d.id == id && d.status == 'new' && d.link is string && d.link.size() >= 40
        && d.name is string && d.name.size() > 1 && d.name.size() <= 120
        && crewText(d, 'photo', 260000) && crewText(d, 'idFront', 260000) && crewText(d, 'idBack', 260000) && crewText(d, 'passportImage', 260000)
        && crewText(d, 'address', 300) && crewText(d, 'phone', 40) && crewText(d, 'trade', 80)
        && crewLinkOf(d).status == 'open' && crewLinkOf(d).untilMs > request.time.toMillis()
        && ((crewLinkOf(d).kind == 'one' && id == d.link) || (crewLinkOf(d).kind in ['crew', 'site'] && id.matches(d.link + '-[0-9a-f]{8}')));
    }
    match /company/main/crewlinks/{id} {
      allow get: if true;
      allow list: if seesAll();
      allow create: if (isOwner() || 'general_manager' in ranks() || fieldStaff()) && id.size() >= 40 && request.resource.data.id == id && request.resource.data.by == me()
        && request.resource.data.kind in ['one', 'crew'] && request.resource.data.status == 'open'
        && request.resource.data.untilMs is int && request.resource.data.untilMs <= request.time.toMillis() + 8 * 86400000;
      // v0.42.0: Employee data in Field Report: a 12-hour link of the device's own project, for the form filled in there
      allow create: if request.resource.data.kind == 'site' && fieldOn(request.resource.data.projectId) && id.size() >= 40 && request.resource.data.id == id
        && request.resource.data.by == me() && request.resource.data.status == 'open'
        && request.resource.data.untilMs is int && request.resource.data.untilMs <= request.time.toMillis() + 13 * 3600000;
      allow update: if (isOwner() || 'general_manager' in ranks() || fieldStaff()) && resource.data.by == me() && request.resource.data.by == me() && request.resource.data.untilMs <= resource.data.untilMs;
    }
    match /company/main/crewforms/{id} {
      allow create: if crewFormOk(id, request.resource.data);
    }

    // Meetings. The booking page is open to anyone: it reads its settings (public/booking) and which
    // times are taken (slots, which hold no names), and leaves one booking. A slot's id is its time,
    // and a slot can only be created, never overwritten: that is what stops two people taking one time.
    match /public/{doc} {
      allow get: if true;
      allow write: if isOwner();
    }
    match /company/main/slots/{id} {
      allow get, list: if true;
      allow create: if id.matches('^[0-9]{8}T[0-9]{4}Z$')
        && request.resource.data.keys().hasOnly(['id', 'start', 'minutes'])
        && request.resource.data.id == id;
      allow delete: if isOwner() || staffWith(['meetings']);
    }
    match /company/main/bookings/{id} {
      allow create: if request.resource.data.keys().hasOnly(['id', 'start', 'minutes', 'step', 'type', 'typeName', 'where', 'name', 'company', 'email', 'phone', 'note', 'at', 'status', 'division'])
        && (!('division' in request.resource.data) || request.resource.data.division in ['trading', 'installation'])
        && request.resource.data.id == id
        && request.resource.data.status == 'booked'
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 160
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000;
      allow read: if seesAll() || (staffWith(['meetings']) && mine(resource.data));
      allow update: if isOwner() || (staffWith(['meetings']) && mine(resource.data) && mine(request.resource.data));
    }

    // Evaluations and feedback notes: read only by the person who wrote them and by the Admin, never by the
    // person they are about. A list query has to say where by == the signed-in address. Only the author edits.
    match /company/main/evaluations/{id} {
      allow read: if seesAll() || (hasUser() && resource.data.by == me())
        || (hasUser() && 'general_manager' in ranks() && resource.data.get('salaryReview', false) == true);
      allow create: if request.resource.data.by == me()
        && (isOwner() || (hasUser() && mayRate(request.resource.data.level)));
      allow update: if (resource.data.by == me() && request.resource.data.by == me())
        || ((isOwner() || (hasUser() && 'general_manager' in ranks())) && salaryOnly());
      allow delete: if isOwner();
    }
    // v0.49.0: Spotlight notes. About a person: written by who may rate them; a project update: by anyone signed in.
    // Read by the writer, HR and the Admin, never by the person. Changed by the writer (24 hours in the app); deleted by the Admin.
    // v0.50.1: HR marks the office staff's attendance from the names-and-positions list the Admin's app keeps
    function isHR() { return hasUser() && 'hr_assistant' in ranks(); }
    match /company/main/officeAttendance/{id} {
      allow read, delete: if isHR();
      allow create, update: if isHR() && request.resource.data.id == id && request.resource.data.by == me();
    }
    match /company/main/officeStaff/{id} {
      allow read: if isHR();
    }
    // v0.53.0: the company stamp is the Admin's; Office reads it to print it. Each use is logged in the user's own name, read by the Admin
    match /company/main/seals/{id} {
      allow read: if isOffice();
    }
    match /company/main/sealLog/{id} {
      allow create: if (isOwner() || isOffice()) && request.resource.data.by == me() && request.resource.data.id == id;
    }
    match /company/main/spotlight/{id} {
      allow read: if seesAll() || (hasUser() && ('hr_assistant' in ranks() || resource.data.by == me()));
      allow create: if hasUser() && request.resource.data.by == me() && request.resource.data.id == id
        && (request.resource.data.kind == 'project' || isOwner() || mayRate(request.resource.data.level));
      allow update: if hasUser() && ((resource.data.by == me() && request.resource.data.by == me())
        || (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt'])));
      allow delete: if isOwner();
    }

    // Discuss messages: everyone with access reads them and writes their own. The sender may correct the text within
    // a minute of sending (the app allows 30 seconds; the rest is for a slow connection), and take a message back at
    // any time, which empties it and marks it deleted. The Admin may take back anyone's. Nothing else changes.
    function messageKept() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'deleted', 'deletedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
    }
    function messageTakenBack() { return request.resource.data.get('deleted', false) == true && request.resource.data.text == ''; }
    function messageCorrected() {
      return request.resource.data.get('deleted', false) == false && resource.data.get('deleted', false) == false
        && request.time.toMillis() < resource.data.get('sentMs', 0) + 60000;
    }
    match /company/main/messages/{record} {
      allow update: if messageKept() && ((resource.data.by == me() && (messageTakenBack() || messageCorrected()))
        || (isOwner() && messageTakenBack()));
    }

    match /company/main/{section}/{record} {
      allow read: if seesAll()
        || (section == 'messages' && hasUser())
        || (section in ['shipments', 'sales'] && staffWith(['trade', 'finance']) && mine(resource.data))
        || (section == 'contracts' && staffWith(['contracts']) && mine(resource.data))
        || (section == 'contacts' && staffWith(['contacts']) && mine(resource.data))
        || (section == 'meetings' && staffWith(['meetings']) && mine(resource.data));
      allow create: if section == 'messages' && (isOwner() || hasUser()) && request.resource.data.by == me();
      allow create, update: if (isOwner() && section != 'messages')
        || (section in ['shipments', 'sales'] && staffWith(['trade']) && keptMine())
        || (section == 'contracts' && staffWith(['contracts']) && keptMine())
        || (section == 'contacts' && staffWith(['contacts']) && keptMine())
        // meetings with colleagues: anyone of the division with Meetings ticked schedules one; only its organiser changes it
        || (section == 'meetings' && staffWith(['meetings']) && keptMine() && request.resource.data.by == me() && (resource == null || resource.data.by == me()));
      allow delete: if isOwner();
    }

    match /projects/{pid} {
      allow get: if seesAll() || officeOn(pid) || isSiteOn(pid) || fieldOn(pid);
      allow list: if seesAll();
      // project settings are the Admin's; an Office user may only refresh the sidebar figures
      // and confirm which Field Report project a code belongs to
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || (officeOn(pid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['summary', 'fieldLabel']));

      match /{section}/{record} {
        allow read: if seesAll() || officeReadsIn(pid, section)
          || (section in ['reports', 'team', 'requests', 'fieldDay', 'attendance'] && fieldOn(pid))
          || (isSiteOn(pid) && section in ['tasks', 'reports', 'items', 'team', 'assemblies', 'procurement', 'requests', 'attendance'])
          // a Site person with a money page ticked reads the money records of their projects, never pay
          || (isSiteOn(pid) && isMoney(section) && !isPay(section) && staffWith(moneyPages()));
        allow create: if isOwner()
          || (officeWritesIn(pid, section) && (section != 'docs' || !isIssued(request.resource.data) || canApprove()))
          || (isSiteOn(pid) && section in ['reports', 'items'])
          // with Costs ticked a Site person enters costs; with Invoices and documents, drafts (never issued)
          || (isSiteOn(pid) && section == 'ledger' && staffWith(['ledger']))
          || (isSiteOn(pid) && section == 'docs' && staffWith(['docs']) && !isIssued(request.resource.data))
          // a Site user may only raise a request, as one waiting for approval
          || (isSiteOn(pid) && section == 'requests' && request.resource.data.status == 'requested')
          // v0.39.0: today's attendance marks shared between a project's Field Report phones and computers
          || (section == 'fieldDay' && fieldOn(pid))
          // v0.42.0: a Field Report device sends an attendance correction for the office to review, in its own name
          || (section == 'attendance' && fieldOn(pid) && record.matches('sr_.+') && request.resource.data.get('site', false) == true && request.resource.data.review == 'waiting' && request.resource.data.byEmail == me())
          // v0.38.0: a Field Report phone writes a request of its project as a draft, in its own name
          || (section == 'requests' && fieldOn(pid) && request.resource.data.get('site', false) == true && request.resource.data.status == 'draft' && request.resource.data.by == me());
        allow update: if isOwner()
          || (officeWritesIn(pid, section) && (section != 'docs' || (!isIssued(request.resource.data) && !isIssued(resource.data)) || canApprove()))
          || (isSiteOn(pid) && section in ['reports', 'items'])
          || (isSiteOn(pid) && section == 'ledger' && staffWith(['ledger']))
          || (isSiteOn(pid) && section == 'docs' && staffWith(['docs']) && !isIssued(request.resource.data) && !isIssued(resource.data))
          // ...and change or withdraw it only while nobody has answered it
          || (isSiteOn(pid) && section == 'requests' && resource.data.status == 'requested' && request.resource.data.status in ['requested', 'cancelled'])
          || (section == 'fieldDay' && fieldOn(pid))   // v0.39.0
          || (section == 'attendance' && fieldOn(pid) && record.matches('sr_.+') && request.resource.data.get('site', false) == true && request.resource.data.review == 'waiting' && request.resource.data.byEmail == me())   // v0.42.0
          // v0.38.0: a site draft is changed, deleted or sent by any phone of the project; once sent, only its writer withdraws it
          || (section == 'requests' && fieldOn(pid) && resource.data.get('site', false) == true && request.resource.data.get('site', false) == true && request.resource.data.by == resource.data.by
            && ((resource.data.status == 'draft' && request.resource.data.status in ['draft', 'deleted', 'requested'])
              || (resource.data.status == 'requested' && request.resource.data.status == 'cancelled' && resource.data.by == me()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'log', 'editedBy', 'editedAt']))))
          // v0.43.0: a Field Report phone asks the PM or the GM to delete a crew member (the server deletes on their confirm)
          || (section == 'team' && fieldOn(pid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dropAsk', 'editedBy', 'editedAt']))
          // v0.37.0: a Field Report phone corrects or takes off a crew member the site added (name, trade, phone only)
          || (section == 'team' && fieldOn(pid) && resource.data.get('fromSite', null) != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'contact', 'active', 'editedBy', 'editedAt']));
        // nobody but the Admin deletes a record
        allow delete: if isOwner();
      }
    }
  }
}
